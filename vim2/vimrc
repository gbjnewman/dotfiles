" Plugin configuration
source ~/.vim/vimrc_pluggins.vim

" colorscheme / theme
set t_Co=256    " deprecated terminal colour-count setting retained from vimrc
set background=dark
colorscheme habamax

" Custom Statusline
set laststatus=2

" dictionary to convert mode() output to something more readable
let g:modedisplay={
    \\ 'n'  : 'Normal',
    \\ 'no' : 'Normal·Operator Pending',
    \\ 'v'  : 'Visual',
    \\ 'V'  : 'V·Line',
    \\ '^V' : 'V·Block',
    \\ 's'  : 'Select',
    \\ 'S'  : 'S·Line',
    \\ '^S' : 'S·Block',
    \\ 'i'  : 'Insert',
    \\ 'R'  : 'Replace',
    \\ 'Rv' : 'V·Replace',
    \\ 'c'  : 'Command',
    \\ 'cv' : 'Vim Ex',
    \\ 'ce' : 'Ex',
    \\ 'r'  : 'Prompt',
    \\ 'rm' : 'More',
    \\ 'r?' : 'Confirm',
    \\ '!'  : 'Shell',
    \\ 't'  : 'Terminal'
    \\}

set statusline+=%F    " add full filepath of opened file to statusline
set statusline+=\\ \\-\\ filetype:%Y    " add filetype
set statusline+=%=    " add a left-right split point
"set statusline+=\\ mode:%{toupper(g:modedisplay[mode()])}    " add current mode
"set statusline+=\\ %p%%    " add percentage through file in lines
set statusline+=\\line\\ %l\\    " add line number
set statusline+=\\:\\ col\\ %v    " add column number

" custom fold line
function! MyFoldText()
    " Number of dashes based on fold level
    let nestedlevel = repeat('-', v:foldlevel)
    " calculate how many lines in the fold
    let numoflines = v:foldend - v:foldstart + 1
    " get the text line on the first line of the fold
    let comment = getline(v:foldstart)
    " make this amount of dashes to add to the fold text line
    let dashes = repeat('-', (70-len(nestedlevel)-len(numoflines)-len(comment)))

    return '+'.nestedlevel.' '.numoflines.' lines:'.comment.' '.dashes
endfunction

set foldtext=MyFoldText()
set fillchars=fold:\\ 

" Misc settings
filetype plugin on
set history=1000
set viminfo='1000
set viminfo+=<1000
set viminfo+=s1000000
set viewoptions=folds
set shortmess=aoOtTI
set nofixendofline
set wrapscan
set listchars=space:·,trail:•,nbsp:*,extends:>,precedes:<,tab:\\\\│\\\\>
set list
set foldmethod=manual
set foldmarker={{{,}}}
set foldcolumn=2
set autoindent
set breakindent
set autowrite
set showcmd
set number
set cursorline
set cursorlineopt=number
set norelativenumber
set showmode
set t_vb=
set smarttab
set tabstop=4
set softtabstop=4
"set expandtab
set shiftwidth=4
set smartindent
set textwidth=130
set colorcolumn=130
set timeout
set timeoutlen=2000
set spellcapcheck=
set ignorecase
set smartcase
set nobackup
set directory^=$HOME/.vim/swapfiles//
set nowritebackup
set icon
set scrolloff=8
set hlsearch
set linebreak
set showbreak=>>\\ 
set ttyfast
set wildmenu
syntax enable

" key maps
let mapleader=\",\"
nnoremap <LEADER>n :NERDTreeToggle<CR>
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap Y y$
nnoremap H b
nnoremap L w
map <F1> :set number!<CR>
map <F2> :set relativenumber!<CR>
map <F3> :set list!<CR>
nnoremap <leader>o o<esc>k
nnoremap \\\\ :nohlsearch<return>

" AUTOCMDs
autocmd FileType c,cpp nnoremap <Leader>{ i{<CR>}<Esc>O

augroup remember_folds
    autocmd!
    autocmd BufWinLeave * mkview
    autocmd BufWinEnter * silent! loadview
augroup end

