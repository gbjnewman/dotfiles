set writebackup&vim    "make a backup before overwriting a file
set writedelay&vim    "delay this many msec for each char (for debug)
" X
set xtermcodes&vim    "request terminal codes from an xterm

" The following options are intentionally not forced to fixed values:
" columns, lines, term, ttymouse and ttytype are determined by the terminal.
