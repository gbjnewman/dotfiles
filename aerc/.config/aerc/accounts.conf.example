[Proton]
source = imap+insecure://<BRIDGE_USERNAME_URL_ENCODED>@127.0.0.1:1143
source-cred-cmd = secret-tool lookup application aerc account proton-bridge

outgoing = smtp+insecure://<BRIDGE_USERNAME_URL_ENCODED>@127.0.0.1:1025
outgoing-cred-cmd = secret-tool lookup application aerc account proton-bridge

from = <EMAIL>
default = INBOX
